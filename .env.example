# Public browser settings. Do not put API keys or passwords here.
# Vite only exposes VITE_ variables to the browser; restart dev after editing.
# The country selector is appended as ?countryIso2=... at request time.
VITE_BASE_API_URL=http://localhost:8083
VITE_CONTACT_API_URL=/api/contact
VITE_COUNTRY_ISO2=DF
