{
  "folders": [{ "path": "." }],
  "settings": {
    "files.exclude": { "**/*.tsbuildinfo": true },
    "search.exclude": { "**/node_modules": true, "**/dist": true },
    "typescript.tsdk": "node_modules/typescript/lib"
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      { "label": "Setup dependencies", "type": "process", "command": "powershell.exe", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/work.ps1", "setup"], "problemMatcher": [] },
      { "label": "Start site", "type": "process", "command": "powershell.exe", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/work.ps1", "dev"], "problemMatcher": [] },
      { "label": "Check types", "type": "process", "command": "powershell.exe", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/work.ps1", "check"], "problemMatcher": [] },
      { "label": "Build site", "type": "process", "command": "powershell.exe", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/work.ps1", "build"], "group": { "kind": "build", "isDefault": true }, "problemMatcher": [] }
    ]
  }
}
